# Değerler yalnızca .env.local ve Netlify ortam değişkenlerinde tutulur; bu dosya şablondur.

# === ANALYTICS (çerez onayı sonrası yüklenir) ===
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# === E-POSTA (Resend) — form e-posta kopyası ===
# EMAIL_FROM adresinin alan adı Resend'de doğrulanmış olmalıdır.
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=no-reply@baskanhavlu.com
EMAIL_TO_SALES=tekstil@baskanhavlu.com

# === RATE LIMITING (Upstash Redis) — tanımlı değilse sınırlama devre dışı ===
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxx

# === WEBMASTER ARAÇLARI ===
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxx
NEXT_PUBLIC_BING_SITE_VERIFICATION=xxxxxxxxxxxx
